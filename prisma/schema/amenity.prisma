model Amenity {
  id          String   @id @default(uuid()) @db.Uuid

  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)

  icon        String?
  description String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())

  properties  PropertyAmenity[]

  @@map("amenities")
}
