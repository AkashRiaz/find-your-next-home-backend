model Property {
  id               String        @id @default(uuid()) @db.Uuid

  // Foreign keys
  ownerId          String        @db.Uuid
  categoryId       String?       @db.Uuid
  locationId       String?       @db.Uuid

  // Advertiser information
  advertiserType   AdvertiserType @default(OWNER)

  // Basic details
  title            String?       @db.VarChar(200)
  description      String?       @db.Text

  status           ListingStatus @default(DRAFT)

  // Rental information
  monthlyRent      Decimal?      @db.Decimal(12, 2)
  securityDeposit  Decimal?      @db.Decimal(12, 2)
  advanceAmount    Decimal?      @db.Decimal(12, 2)
  serviceCharge    Decimal?      @db.Decimal(12, 2)

  isNegotiable     Boolean       @default(false)

  // Property structure
  bedrooms         Int?
  bathrooms        Int?
  balconies        Int?
  floorNumber      Int?
  totalFloors      Int?
  areaSqFt         Int?

  furnishingStatus FurnishingStatus?

  // Shared accommodation
  totalSeats       Int?
  availableSeats   Int?
  sharingCapacity  Int?

  genderPreference GenderPreference @default(ANY)
  preferredTenant  PreferredTenant  @default(ANY)

  // Location details
  holdingNumber   String?  @db.VarChar(100)
  houseNumber     String?  @db.VarChar(100)
  roadNumber      String?  @db.VarChar(100)
  buildingName    String?  @db.VarChar(200)
  flatNumber      String?  @db.VarChar(50)
  block           String?  @db.VarChar(100)
  sector          String?  @db.VarChar(100)
  village         String?  @db.VarChar(150)
  wardNumber      String?  @db.VarChar(50)
  postalCode      String?  @db.VarChar(20)
  address          String?       @db.Text
  landmark         String?

  latitude         Decimal?      @db.Decimal(10, 7)
  longitude        Decimal?      @db.Decimal(10, 7)

  // Rental availability
  availableFrom    DateTime?

  minimumStayMonths Int?

  // Listing management
  publishedAt      DateTime?
  rentedAt         DateTime?
  archivedAt       DateTime?

  // Dates
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relationships
  owner            User @relation(fields: [ownerId], references: [id] )

  category         PropertyCategory? @relation(fields: [categoryId], references: [id])

  location         Location? @relation( fields: [locationId], references: [id])

  images           PropertyImage[]
  attributes       PropertyAttribute[]
  amenities        PropertyAmenity[]

  favorites        Favorite[]
  conversations    Conversation[]

  reports          Report[]
  moderationActions ModerationAction[]

  @@index([ownerId, status])
  @@index([categoryId, status])
  @@index([locationId, status])

  @@index([status, publishedAt])
  @@index([status, monthlyRent])

  @@index([availableFrom])
  @@index([createdAt])

  @@map("properties")
}