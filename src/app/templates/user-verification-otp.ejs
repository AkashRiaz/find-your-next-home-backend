
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Your ToLet Account</title>
</head>

<body style="
  margin: 0;
  padding: 0;
  background-color: #f3f7f4;
  font-family: Arial, Helvetica, sans-serif;
">
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color: #f3f7f4; padding: 40px 15px;"
  >
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            width: 100%;
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
          "
        >

          <!-- Header -->
          <tr>
            <td
              align="center"
              style="
                background-color: #16734a;
                padding: 32px 20px;
              "
            >
              <h1 style="
                margin: 0;
                color: #ffffff;
                font-size: 32px;
                letter-spacing: 1px;
              ">
                ToLet
              </h1>

              <p style="
                margin: 10px 0 0;
                color: #d9f4e5;
                font-size: 14px;
              ">
                Find Your Next Home
              </p>
            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td style="padding: 35px 30px;">

              <h2 style="
                margin: 0 0 20px;
                color: #142a1e;
                font-size: 23px;
              ">
                Verify Your Email Address
              </h2>

              <p style="
                margin: 0 0 15px;
                color: #374151;
                font-size: 16px;
              ">
                Hello <strong><%= name %></strong>,
              </p>

              <p style="
                margin: 0 0 25px;
                color: #4b5563;
                font-size: 15px;
                line-height: 1.7;
              ">
                Welcome to <strong>ToLet!</strong>
                We're excited to have you join our rental community.
                Please verify your email address to activate your
                account and start exploring available rental properties.
              </p>

              <!-- OTP Section -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  background-color: #eff8f1;
                  border: 1px solid #cce8d5;
                  border-radius: 10px;
                "
              >
                <tr>
                  <td
                    align="center"
                    style="padding: 25px 15px;"
                  >
                    <p style="
                      margin: 0 0 15px;
                      color: #526b5c;
                      font-size: 13px;
                      font-weight: bold;
                    ">
                      YOUR VERIFICATION CODE
                    </p>

                    <p style="
                      margin: 0;
                      color: #16734a;
                      font-size: 34px;
                      font-weight: bold;
                      letter-spacing: 7px;
                      line-height: 1.4;
                    ">
                      <%= otp %>
                    </p>

                    <p style="
                      margin: 15px 0 0;
                      color: #526b5c;
                      font-size: 13px;
                    ">
                      This code expires in
                      <strong>
                        <%= expirationMinutes %> minutes
                      </strong>.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Information -->
              <p style="
                margin: 25px 0 0;
                color: #4b5563;
                font-size: 14px;
                line-height: 1.7;
              ">
                Enter this code on the ToLet verification page
                to complete your registration.
              </p>

              <!-- Security Notice -->
              <table
                width="100%"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="
                  margin-top: 25px;
                  background-color: #fffbeb;
                  border: 1px solid #fde68a;
                  border-radius: 8px;
                "
              >
                <tr>
                  <td style="padding: 18px;">
                    <p style="
                      margin: 0 0 8px;
                      color: #92400e;
                      font-size: 14px;
                      font-weight: bold;
                    ">
                      Security Notice
                    </p>

                    <p style="
                      margin: 0;
                      color: #92400e;
                      font-size: 13px;
                      line-height: 1.6;
                    ">
                      Never share your verification code
                      with anyone. ToLet will never ask
                      you to share your OTP.

                      If you did not create this account,
                      you can safely ignore this email.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="
                margin: 25px 0 0;
                color: #4b5563;
                font-size: 14px;
                line-height: 1.7;
              ">
                Thank you for choosing ToLet.
                We hope you find your perfect home!
              </p>

              <p style="
                margin: 20px 0 0;
                color: #16734a;
                font-size: 14px;
                font-weight: bold;
              ">
                The ToLet Team
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              align="center"
              style="
                background-color: #f7faf8;
                padding: 25px 20px;
                border-top: 1px solid #e5e7eb;
              "
            >
              <p style="
                margin: 0;
                color: #6b7280;
                font-size: 12px;
              ">
                This is an automated email.
                Please do not reply.
              </p>

              <p style="
                margin: 10px 0 0;
                color: #9ca3af;
                font-size: 12px;
              ">
                &copy; <%= new Date().getFullYear() %>
                ToLet. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>
