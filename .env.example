# Copy this file to .env and fill in your own values.
# Never put real secrets in this file: it is committed to git.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database (Prisma Postgres or any PostgreSQL connection string)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# SMTP (for Gmail, use an app password)
SMTP_USER=you@example.com
SMTP_PASSWORD="your-smtp-app-password"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# bKash
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_CALLBACK_URL=http://localhost:5000/api/v1
BKASH_REFUND_URL=https://tokenized.sandbox.bka.sh/v2

# Google sign-in
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Seed accounts
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=admin@example.com
TESTER_ADMIN_PASSWORD=change-me

TESTER_DEPARTMENT_ADMIN_NAME=Tester Department Admin
TESTER_DEPARTMENT_ADMIN_EMAIL=departmentadmin@example.com
TESTER_DEPARTMENT_ADMIN_PASSWORD=change-me

TESTER_REGISTRAR_NAME=Tester Registrar
TESTER_REGISTRAR_EMAIL=registrar@example.com
TESTER_REGISTRAR_PASSWORD=change-me

TESTER_FINANCE_ADMIN_NAME=Tester Finance Admin
TESTER_FINANCE_ADMIN_EMAIL=finance@example.com
TESTER_FINANCE_ADMIN_PASSWORD=change-me
